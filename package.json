{
  "name": "carcassonne",
  "version": "1.0.1",
  "description": "Carcassonne boardgame module for boardgame-web-ts",
  "license": "ISC",
  "author": "",
  "homepage": "https://github.com/HMHamster88/boardgame-web-carcassonne",
  "repository": {
    "type": "git",
    "url": "https://github.com/HMHamster88/boardgame-web-carcassonne.git"
  },
  "type": "module",
  "main": "index.js",
  "workspaces": [
    "back",
    "front"
  ],
  "scripts": {
    "link-common": "npm run link-common -w back && npm run link-common -w front",
    "build-back": "npm run build -w back && npm run copy-back",
    "build-front": "npm run build -w front && npm run copy-front",
    "build-all": "npm run build-back && npm run build-front",
    "copy-back": "node copy.js -back",
    "copy-front": "node copy.js -front",
    "create-zip": "node create-zip.js",
    "create-release": "npm run build-all && npm run create-zip",
    "render-tiles": "node ./scripts/render-tiles.mjs",
    "proc-routes": "node ./processing/process-routes-images.ts",
    "proc-game-field": "node ./processing/game-field-to-svg.ts",
    "proc-svg": "npx tsx ./processing/svg-to-json.ts"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "@types/svg-parser": "^2.0.6",
    "adm-zip": "^0.5.18",
    "dotenv": "^17.4.2"
  },
  "dependencies": {
    "jimp": "^1.6.1",
    "opencv-ts": "^1.3.6",
    "svg-parser": "^2.1.0",
    "svg-path-commander": "^2.3.3",
    "transformation-matrix": "^3.1.0",
    "transliteration": "^2.6.1"
  }
}